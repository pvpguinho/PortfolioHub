<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gametech - Landing Page</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #fff;
        }
        header {
            text-align: center;
            padding: 20px;
            background: #1f1f1f;
        }
        header h1 {
            font-size: 2.5em;
            margin: 10px 0;
        }
        nav {
            background: #ff4500;
            padding: 10px;
            text-align: center;
        }
        nav a {
            color: white;
            margin: 0 15px;
            text-decoration: none;
            font-weight: bold;
        }
        nav a:hover {
            text-decoration: underline;
        }
        .banner {
            max-width: 1000px;
            margin: 20px auto;
            text-align: center;
        }
        .banner img {
            width: 100%;
            border-radius: 12px;
        }
        section {
            padding: 40px 20px;
            max-width: 1200px;
            margin: auto;
        }
        section h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #ff4500;
        }
        .cards {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }
        .card {
            background: #1f1f1f;
            border-radius: 10px;
            padding: 20px;
            width: 300px;
            text-align: center;
            transition: transform 0.3s;
        }
        .card:hover {
            transform: scale(1.05);
        }
        .card img {
            width: 100%;
            border-radius: 8px;
            margin-bottom: 15px;
        }
        .card h3 {
            margin-bottom: 10px;
            color: #ffcc00;
        }
        .card p {
            font-size: 0.95em;
            margin-bottom: 15px;
        }
        .card button {
            background: #ff4500;
            border: none;
            padding: 10px 20px;
            color: white;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
        }
        .card button:hover {
            background: #e03e00;
        }
        footer {
            text-align: center;
            padding: 20px;
            background: #1f1f1f;
            margin-top: 40px;
        }
        footer p {
            margin: 5px 0;
        }
    </style>
</head>
<body>

    <header>
        <h1>Gametech</h1>
        <p>Jogos digitais, consoles e acessórios exclusivos</p>
    </header>

    <nav>
        <a href="#games">Games</a>
        <a href="#utilidades">Utilidades</a>
        <a href="#acessorios">Acessórios</a>
        <a href="hub.html">Voltar ao Hub</a>
    </nav>

    <div class="banner">
        <img src="banner.png" alt="Banner Gametech">
    </div>

    <section id="games">
        <h2>Games</h2>
        <div class="cards">
            <div class="card">
                <img src="ark2.png" alt="Ark 2">
                <h3>Ark 2</h3>
                <p>Lançamento em 24/09/2025. Nova experiência de sobrevivência com Vin Diesel. Garanta já sua cópia!</p>
                <button>Comprar Agora</button>
            </div>
        </div>
    </section>

    <section id="utilidades">
        <h2>Utilidades</h2>
        <div class="cards">
            <div class="card">
                <img src="cadeira.png" alt="Cadeira Gamer Snake Lancaster">
                <h3>Cadeira Gamer Snake Lancaster</h3>
                <p>Conforto e ergonomia para longas sessões. Estoque disponível e preço especial!</p>
                <button>Ver Detalhes</button>
            </div>
        </div>
    </section>

    <section id="acessorios">
        <h2>Acessórios</h2>
        <div class="cards">
            <div class="card">
                <img src="suporte.png" alt="Suporte Gaming BG500">
                <h3>Suporte Gaming BG500</h3>
                <p>Design arrojado com RGB e 6 níveis de altura. Estoque alto esperando por você!</p>
                <button>Adicionar ao Carrinho</button>
            </div>
        </div>
    </section>

    <footer>
        <p>© 2025 - Gametech</p>
        <p>Landing Page feita por Pedro Vinícius</p>
    </footer>

</body>
</html>
